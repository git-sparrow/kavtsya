# ---- Node / JS ----
node_modules/
npm-debug.*
yarn-error.*
yarn-debug.*
*.log

# ---- Expo / React Native ----
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Expo / EAS
.easignore

# ---- Native ----
# CNG: ios/ and android/ are regenerated by `expo prebuild` / `expo run:*`
# (managed workflow, ADR-locked) — treat them as build output, never commit.
/ios/
/android/
ios/Pods/
ios/build/
android/.gradle/
android/build/
android/app/build/
*.keystore
!debug.keystore

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.pem

# ---- Editor / OS ----
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
# Shared editor config, not personal preference: it pins the TypeScript the
# editor reports errors with to the one CI uses. See the comments in the file.
!.vscode/settings.json
*.swp
Thumbs.db

# ---- Misc ----
coverage/
.cache/
tmp/

# ---- Personal /teach learning workspace (not product code) ----
learning/

# Generated flow screenshots (regenerate via apps/mobile/.maestro/capture.sh)
docs/flows/shots/
