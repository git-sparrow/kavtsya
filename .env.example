# Copy to .env (git-ignored) for local development.

# ---- API ----
# Local dev database (docker compose service `db`).
DATABASE_URL=postgres://kavtsya:kavtsya@localhost:5432/kavtsya
PORT=3000

# Better Auth session signing secret (≥32 chars). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32+-char-random-secret
# Public base URL Better Auth issues cookies against (defaults to this).
BETTER_AUTH_URL=http://localhost:3000
# Signs the rotating Customer QR token (ADR 0006); ≥32 chars, distinct from
# BETTER_AUTH_SECRET so it can be rotated independently. Generate with:
#   openssl rand -base64 32
QR_TOKEN_SECRET=replace-me-with-a-32+-char-random-secret

# ---- Tests ----
# Separate database on the same local Postgres, created by docker/initdb.
TEST_DATABASE_URL=postgres://kavtsya:kavtsya@localhost:5432/kavtsya_test

# ---- Mobile (Expo) ----
# Where the Expo app reaches the API. iOS simulator: localhost.
# Android emulator: http://10.0.2.2:3000. Physical device: your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000

# ---- Anthropic API (Ворожка, ADR 0007) ----
# Used ONLY by the daily fortune batch + smoke scripts — the API server never
# calls the model (ADR 0009) and boots fine without these. In production the
# same variables live on the Railway cron service, not in a file.
# Create/revoke keys at https://console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=sk-ant-api03-replace-me
# Optional overrides of the AIProvider factory defaults (ADR 0007). AI_MODEL
# must be an exact model ID; the default is claude-sonnet-5.
#AI_PROVIDER=claude
#AI_MODEL=claude-sonnet-5
# How many fortunes the daily batch generates (default 30). Only affects
# future batches — a day already generated is never topped up.
#FORTUNES_BATCH_SIZE=30
