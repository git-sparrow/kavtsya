# Enforce the PR-only workflow: never push directly to a protected branch.
# GitHub-side branch protection isn't available on this repo's plan yet (private
# + free), so this hook is the local guardrail — see CONTRIBUTING.md. It runs
# for everyone once `pnpm install` sets husky up. A genuine exception can still
# push with `git push --no-verify`.

protected_branches="main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#refs/heads/}"
  for protected in $protected_branches; do
    if [ "$branch" = "$protected" ]; then
      echo "" >&2
      echo "✖ Direct pushes to '$protected' are blocked — we deliver via PR." >&2
      echo "  Put your work on a branch and open a pull request:" >&2
      echo "    git switch -c feat/short-description" >&2
      echo "    git push -u origin HEAD   &&   gh pr create" >&2
      echo "  See CONTRIBUTING.md. Real exception: git push --no-verify" >&2
      echo "" >&2
      exit 1
    fi
  done
done

exit 0
