{
  "name": "kavtsya",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @kavtsya/api dev",
    "dev:mobile": "pnpm --filter @kavtsya/mobile start",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db",
    "db:seed-demo": "pnpm --filter @kavtsya/api seed-demo",
    "db:seed-demo-fresh": "pnpm --filter @kavtsya/api seed-demo-fresh",
    "migrate": "pnpm --filter @kavtsya/api migrate",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test --test-timeout=60000 'scripts/**/*.test.mjs'",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm agents:check && pnpm deps:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "husky",
    "agents:check": "node scripts/check-agent-setup.mjs",
    "deps:check": "node scripts/deps-check/check-deps.mjs"
  },
  "devDependencies": {
    "@swmansion/argent": "0.27.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "railway": "^3.16.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  }
}
