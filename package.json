{
  "name": "kavtsya",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @kavtsya/api dev",
    "dev:mobile": "pnpm --filter @kavtsya/mobile start",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:seed-demo": "pnpm --filter @kavtsya/api seed-demo",
    "db:seed-demo-fresh": "pnpm --filter @kavtsya/api seed-demo-fresh",
    "migrate": "pnpm --filter @kavtsya/api migrate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@swmansion/argent": "0.20.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "catalog:",
    "typescript-eslint": "^8.66.0"
  }
}
