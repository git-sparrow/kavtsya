---
interface Props {
  collected: number;
  total: number;
}

const { collected, total } = Astro.props;
const beans = Array.from({ length: total }, (_, i) => i < collected);
---

<div class="beans" aria-hidden="true">
  {
    beans.map((filled) => (
      <svg width="20" height="26" viewBox="0 0 20 26">
        {filled ? (
          <>
            <ellipse cx="10" cy="13" rx="7.5" ry="11" transform="rotate(14 10 13)" class="filled" />
            <path d="M12 4c-4 4 2 8-2 9s0 7-2 9" class="crease" />
          </>
        ) : (
          <ellipse cx="10" cy="13" rx="7" ry="10.5" transform="rotate(14 10 13)" class="empty" />
        )}
      </svg>
    ))
  }
</div>

<style>
  .beans {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .filled {
    fill: var(--color-primary-400);
  }

  .crease {
    fill: none;
    stroke: var(--color-primary-700);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .empty {
    fill: none;
    stroke: var(--l-bean-empty);
    stroke-width: 1.4;
    stroke-dasharray: 3 2.5;
  }
</style>
