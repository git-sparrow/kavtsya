---
import Mark from "../../assets/kavtsya-mark.svg";
import { BRAND, CONTACT_MAILTO } from "../../site";

const sections = [
  { href: "#how", label: "Як це працює" },
  { href: "#cafe", label: "Для кав’ярні" },
  { href: "#faq", label: "Питання" },
];
const CTA = "Обговорити підключення";
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="#top" aria-label={`${BRAND} — на початок сторінки`}>
      <Mark class="mark" width={40} height={40} aria-hidden="true" />
      <span class="name">{BRAND}</span>
    </a>
    <nav class="nav-desktop" aria-label="Основна навігація">
      {sections.map(({ href, label }) => <a class="nav-link" href={href}>{label}</a>)}
      <a class="btn btn--primary header-cta" href={CONTACT_MAILTO}>{CTA}</a>
    </nav>
    <button
      type="button"
      class="menu-button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
      data-label-closed="Меню"
      data-label-open="Закрити"
    >
      <span class="burger" aria-hidden="true"><span></span><span></span></span>
      <span data-menu-label>Меню</span>
    </button>
  </div>
  <nav id="mobile-menu" class="nav-mobile" aria-label="Основна навігація" hidden>
    {sections.map(({ href, label }) => <a class="menu-link" href={href}>{label}</a>)}
    <a class="btn btn--primary menu-cta" href={CONTACT_MAILTO}>{CTA}</a>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.getElementById("mobile-menu");
  const label = button?.querySelector("[data-menu-label]");

  if (button && menu && label) {
    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      label.textContent = (open ? button.dataset.labelOpen : button.dataset.labelClosed) ?? "";
      menu.hidden = !open;
    };

    button.addEventListener("click", () => setOpen(menu.hidden));
    menu.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });
    // Layout switches in CSS; this only drops an open menu's state once it is hidden.
    matchMedia("(min-width: 901px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--l-bg);
    border-bottom: 1px solid var(--l-hairline);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 4.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    color: var(--l-fg);
    text-decoration: none;
  }

  .mark {
    flex: none;
    border-radius: var(--radius-sm);
  }

  .name {
    font-family: var(--font-family-display);
    font-size: 1.875rem;
    font-weight: var(--font-weight-semibold);
    line-height: 1;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border-radius: var(--radius-sm);
    color: var(--l-fg);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .nav-link:hover {
    background: var(--l-hover);
    color: var(--l-fg);
  }

  .header-cta {
    min-height: 3rem;
    margin-left: var(--space-3);
    padding: 0 1.375rem;
    font-size: var(--font-size-base);
  }

  .menu-button {
    display: none;
    align-items: center;
    gap: 0.625rem;
    min-height: 3rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--semantic-border-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--l-fg);
    font: var(--font-weight-semibold) var(--font-size-base) / 1
      var(--font-family-body);
    cursor: pointer;
  }

  .burger {
    display: grid;
    gap: 5px;
    width: 18px;
  }

  .burger span {
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .nav-mobile {
    display: grid;
    padding: var(--space-2) var(--l-gutter) var(--space-6);
    border-top: 1px solid var(--l-hairline);
    background: var(--l-bg);
  }

  .nav-mobile[hidden] {
    display: none;
  }

  .menu-link {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    color: var(--l-fg);
    font-size: 1.25rem;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .menu-link:hover {
    color: var(--l-fg);
  }

  .menu-link + .menu-link {
    border-top: 1px solid var(--l-hover);
  }

  .menu-cta {
    min-height: 3.25rem;
    margin-top: var(--space-3);
    font-size: 1.0625rem;
  }

  @media (max-width: 900px) {
    .nav-desktop {
      display: none;
    }

    .menu-button {
      display: flex;
    }
  }

  @media (min-width: 901px) {
    .nav-mobile,
    .nav-mobile[hidden] {
      display: none;
    }
  }
</style>
