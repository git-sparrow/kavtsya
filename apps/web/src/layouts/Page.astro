---
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/cormorant-garamond/600.css";
import "../styles/tokens.css";
import "../styles/base.css";
import mark from "../assets/kavtsya-mark.svg";
import Footer from "../components/Footer.astro";
import { BRAND, PAGES } from "../site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = `${title} · ${BRAND}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={mark.src} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до змісту</a>
    <header class="site-header">
      <a class="brand" href={PAGES.home.path}>
        {BRAND}
      </a>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
