---
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/700.css";
import "@fontsource/cormorant-garamond/600.css";
import "../styles/tokens.css";
import "../styles/base.css";
import { BRAND, CONTACT_EMAIL, CONTROLLER, PAGES } from "../site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title === BRAND ? BRAND : `${title} · ${BRAND}`;
const isHome = Astro.url.pathname === PAGES.home.path;
const canonical = new URL(Astro.url.pathname, Astro.site);
const footerLinks = [PAGES.privacy, PAGES.deleteAccount, PAGES.support];
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до основного вмісту</a>
    {
      !isHome && (
        <header class="site-header">
          <a class="brand" href={PAGES.home.path}>
            {BRAND}
          </a>
        </header>
      )
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Сторінки сайту">
        <ul>
          {
            footerLinks.map((page) => (
              <li>
                <a
                  href={page.path}
                  aria-current={
                    Astro.url.pathname === page.path ? "page" : undefined
                  }
                >
                  {page.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p>{CONTROLLER}.</p>
      <p>
        Пошта: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </footer>
  </body>
</html>
