{
  "expo": {
    "name": "Kavtsya",
    "slug": "kavtsya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kavtsya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kavtsya.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      }
    },
    "android": {
      "package": "com.kavtsya.app",
      "adaptiveIcon": {
        "backgroundColor": "#291c40",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Кавця використовує камеру, щоб сканувати QR-код клієнта і нараховувати зернятка.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbf6ec",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "backgroundColor": "#241b3a",
            "image": "./assets/images/splash-icon-dark.png"
          },
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-status-bar",
      "./plugins/with-optional-push-entitlement",
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6844a2d6-a989-4f48-a401-33cc0bf0645b"
      }
    },
    "owner": "olekhorob"
  }
}
