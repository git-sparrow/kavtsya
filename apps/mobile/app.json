{
  "expo": {
    "name": "Kavtsya",
    "slug": "kavtsya",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kavtsya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kavtsya.app",
      "supportsTablet": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.kavtsya.app",
      "adaptiveIcon": {
        "backgroundColor": "#fffaf3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Кавця використовує камеру, щоб сканувати QR-код клієнта і нараховувати зернятка."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbf6ec",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
