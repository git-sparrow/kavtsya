# React Native / Expo + Metro expect a flat node_modules layout.
# Hoist dependencies so Metro can resolve them (the standard Expo-monorepo setting).
node-linker=hoisted

# Run pre/post script hooks (e.g. apps/api `predev` runs migrations before dev).
# Explicit so the behaviour is deterministic across machines and pnpm versions.
enable-pre-post-scripts=true
